{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "fingerprint": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "nullableFingerprint": {
      "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }]
    },
    "nullableTransactionRef": {
      "oneOf": [
        {
          "pattern": "^transactions/transaction_(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40(?:[0-8][0-9]|9[0-6]))_[0-9a-f]{64}[.]json$",
          "type": "string"
        },
        { "type": "null" }
      ]
    },
    "sequence": { "maximum": 4096, "minimum": 1, "type": "integer" },
    "utcSecond": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "evidence_sequence": { "const": 1 } },
        "required": ["evidence_sequence"]
      },
      "then": {
        "properties": {
          "previous_transaction_fingerprint": { "type": "null" },
          "previous_transaction_ref": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "previous_transaction_fingerprint": { "$ref": "#/$defs/fingerprint" },
          "previous_transaction_ref": {
            "pattern": "^transactions/transaction_(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40(?:[0-8][0-9]|9[0-6]))_[0-9a-f]{64}[.]json$",
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "$schema": {
      "const": "handbook.schemas.project-condition-evidence-transaction@1.0.0"
    },
    "authenticator_use_head_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "authenticator_use_head_ref": {
      "pattern": "^authenticator-use-heads/[0-9a-f]{64}[.]json$",
      "type": "string"
    },
    "committed_at_utc": { "$ref": "#/$defs/utcSecond" },
    "credential_id_hash": { "$ref": "#/$defs/fingerprint" },
    "evidence_head_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "evidence_sequence": { "$ref": "#/$defs/sequence" },
    "previous_transaction_fingerprint": {
      "$ref": "#/$defs/nullableFingerprint"
    },
    "previous_transaction_ref": { "$ref": "#/$defs/nullableTransactionRef" },
    "producer_verification_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "record_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "record_ref": {
      "pattern": "^records/managed-operational-surface_[0-9a-f]{64}[.]json$",
      "type": "string"
    },
    "schema_id": { "const": "handbook.project-condition-evidence-transaction" },
    "schema_version": { "const": "1.0" },
    "transaction_fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "required": [
    "$schema",
    "schema_id",
    "schema_version",
    "evidence_sequence",
    "previous_transaction_ref",
    "previous_transaction_fingerprint",
    "record_ref",
    "record_fingerprint",
    "evidence_head_fingerprint",
    "credential_id_hash",
    "authenticator_use_head_ref",
    "authenticator_use_head_fingerprint",
    "producer_verification_fingerprint",
    "committed_at_utc",
    "transaction_fingerprint"
  ],
  "type": "object",
  "unevaluatedProperties": false,
  "x-handbook-fingerprint": {
    "algorithm": "sha256",
    "canonicalization": "RFC8785",
    "exclude": ["$schema", "transaction_fingerprint"],
    "field": "transaction_fingerprint"
  },
  "x-handbook-immutable-relative-ref": "transactions/transaction_<four-digit-zero-padded-evidence_sequence>_<transaction_fingerprint-lowercase-hex>.json",
  "x-handbook-max-canonical-json-lf-bytes": 8192,
  "x-handbook-semantic-rules": [
    "previous transaction ref sequence and fingerprint equal the retained sequence N-1 transaction",
    "record_ref and record_fingerprint equal the current immutable evidence record",
    "evidence_head_fingerprint and authenticator-use head pair equal the committed result heads",
    "producer_verification_fingerprint equals the current record verification fingerprint",
    "committed_at_utc equals producer verification verified_at_utc",
    "the dedicated directory contains one unique gap-free fork-free acyclic chain from sequence 1 with at most 4096 entries",
    "the unique maximal transaction selects live state and both mutable heads plus immutable record must equal it",
    "all reads and writes are no-follow regular-file-only with retained identity and canonical-byte checks"
  ]
}
