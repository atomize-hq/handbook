{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "dependencyObservation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dependency_kind": { "const": "evidence_transaction_store" }
            },
            "required": ["dependency_kind"]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "byte_count": { "type": "null" },
                  "claimed_fingerprint": { "type": "null" },
                  "computed_fingerprint": { "type": "null" },
                  "error_code": { "const": "transaction_store_missing" },
                  "logical_id": {
                    "const": "managed-operational-surface-transactions"
                  },
                  "observation_kind": { "const": "absent" },
                  "observed_bytes_fingerprint": { "type": "null" },
                  "relative_ref": {
                    "const": ".handbook/state/project-condition-evidence/transactions"
                  },
                  "required_fingerprint": { "type": "null" }
                }
              },
              {
                "properties": {
                  "byte_count": { "type": "null" },
                  "claimed_fingerprint": { "type": "null" },
                  "computed_fingerprint": { "type": "null" },
                  "error_code": { "const": "transaction_store_unsafe" },
                  "logical_id": {
                    "const": "managed-operational-surface-transactions"
                  },
                  "observation_kind": { "const": "unsafe" },
                  "observed_bytes_fingerprint": { "type": "null" },
                  "relative_ref": {
                    "const": ".handbook/state/project-condition-evidence/transactions"
                  },
                  "required_fingerprint": { "type": "null" }
                }
              },
              {
                "properties": {
                  "byte_count": { "type": "null" },
                  "claimed_fingerprint": { "type": "null" },
                  "computed_fingerprint": { "type": "null" },
                  "error_code": { "const": "transaction_store_read_failed" },
                  "logical_id": {
                    "const": "managed-operational-surface-transactions"
                  },
                  "observation_kind": { "const": "read_error" },
                  "observed_bytes_fingerprint": { "type": "null" },
                  "relative_ref": {
                    "const": ".handbook/state/project-condition-evidence/transactions"
                  },
                  "required_fingerprint": { "type": "null" }
                }
              },
              {
                "properties": {
                  "byte_count": { "type": "null" },
                  "claimed_fingerprint": { "type": "null" },
                  "computed_fingerprint": { "type": "null" },
                  "error_code": { "const": "transaction_store_over_limit" },
                  "logical_id": {
                    "const": "managed-operational-surface-transactions"
                  },
                  "observation_kind": { "const": "directory_limit_exceeded" },
                  "observed_bytes_fingerprint": { "type": "null" },
                  "relative_ref": {
                    "const": ".handbook/state/project-condition-evidence/transactions"
                  },
                  "required_fingerprint": { "type": "null" }
                }
              },
              {
                "properties": {
                  "byte_count": {
                    "maximum": 131072,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "claimed_fingerprint": { "type": "null" },
                  "computed_fingerprint": { "type": "null" },
                  "error_code": {
                    "oneOf": [
                      {
                        "enum": [
                          "transaction_entry_invalid",
                          "transaction_entry_alias"
                        ]
                      },
                      { "type": "null" }
                    ]
                  },
                  "logical_id": {
                    "const": "managed-operational-surface-transactions"
                  },
                  "observation_kind": { "const": "retained_directory" },
                  "observed_bytes_fingerprint": {
                    "$ref": "#/$defs/fingerprint"
                  },
                  "relative_ref": {
                    "const": ".handbook/state/project-condition-evidence/transactions"
                  },
                  "required_fingerprint": { "type": "null" }
                }
              }
            ]
          },
          "else": {
            "oneOf": [
              {
                "properties": {
                  "byte_count": { "type": "null" },
                  "claimed_fingerprint": { "type": "null" },
                  "computed_fingerprint": { "type": "null" },
                  "error_code": { "$ref": "#/$defs/nonStoreError" },
                  "observation_kind": {
                    "enum": ["absent", "unsafe", "read_error"]
                  },
                  "observed_bytes_fingerprint": { "type": "null" },
                  "required_fingerprint": {
                    "$ref": "#/$defs/nullableFingerprint"
                  }
                }
              },
              {
                "allOf": [
                  {
                    "if": {
                      "properties": { "error_code": { "type": "null" } },
                      "required": ["error_code"]
                    },
                    "then": {
                      "properties": {
                        "claimed_fingerprint": {
                          "$ref": "#/$defs/fingerprint"
                        },
                        "computed_fingerprint": {
                          "$ref": "#/$defs/fingerprint"
                        }
                      }
                    }
                  }
                ],
                "properties": {
                  "byte_count": {
                    "maximum": 131072,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "claimed_fingerprint": {
                    "$ref": "#/$defs/nullableFingerprint"
                  },
                  "computed_fingerprint": {
                    "$ref": "#/$defs/nullableFingerprint"
                  },
                  "error_code": {
                    "oneOf": [
                      { "$ref": "#/$defs/nonStoreRetainedError" },
                      { "type": "null" }
                    ]
                  },
                  "observation_kind": { "const": "retained_bytes" },
                  "observed_bytes_fingerprint": {
                    "$ref": "#/$defs/fingerprint"
                  },
                  "required_fingerprint": {
                    "$ref": "#/$defs/nullableFingerprint"
                  }
                }
              }
            ]
          }
        }
      ],
      "properties": {
        "byte_count": {
          "oneOf": [
            { "maximum": 131072, "minimum": 0, "type": "integer" },
            { "type": "null" }
          ]
        },
        "claimed_fingerprint": { "$ref": "#/$defs/nullableFingerprint" },
        "computed_fingerprint": { "$ref": "#/$defs/nullableFingerprint" },
        "dependency_kind": {
          "enum": [
            "evidence_transaction_store",
            "evidence_head",
            "evidence_transaction",
            "evidence_record",
            "admitted_source",
            "condition_definition",
            "evaluator_definition",
            "repository_identity",
            "registry_head_transition",
            "registry_state",
            "credential_registration",
            "authenticator_use_head",
            "challenge",
            "decoded_assertion_response",
            "assertion",
            "evidence_use_transition"
          ]
        },
        "error_code": {
          "oneOf": [
            {
              "enum": [
                "evidence_record_missing",
                "dependency_missing",
                "transaction_store_missing",
                "transaction_store_unsafe",
                "transaction_store_read_failed",
                "transaction_entry_invalid",
                "transaction_entry_alias",
                "transaction_store_over_limit",
                "unsafe_path",
                "identity_changed",
                "read_failed",
                "oversized",
                "non_canonical",
                "schema_invalid",
                "fingerprint_mismatch",
                "wrong_authority",
                "chain_invalid",
                "transaction_tip_mismatch",
                "producer_invalid",
                "dependency_unresolved",
                "not_current",
                "contradiction"
              ]
            },
            { "type": "null" }
          ]
        },
        "logical_id": { "maxLength": 256, "minLength": 1, "type": "string" },
        "observation_kind": {
          "enum": [
            "absent",
            "unsafe",
            "read_error",
            "directory_limit_exceeded",
            "retained_directory",
            "retained_bytes"
          ]
        },
        "observed_bytes_fingerprint": { "$ref": "#/$defs/nullableFingerprint" },
        "relative_ref": { "maxLength": 512, "minLength": 1, "type": "string" },
        "required_fingerprint": { "$ref": "#/$defs/nullableFingerprint" }
      },
      "required": [
        "dependency_kind",
        "logical_id",
        "relative_ref",
        "observation_kind",
        "byte_count",
        "observed_bytes_fingerprint",
        "required_fingerprint",
        "claimed_fingerprint",
        "computed_fingerprint",
        "error_code"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "fingerprint": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "freshnessRow": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "verification_not_yet_valid",
            "observation_not_yet_valid",
            "current",
            "expired"
          ]
        },
        "evaluated_at_utc": { "$ref": "#/$defs/utcSecond" },
        "input_id": { "$ref": "#/$defs/identifier" },
        "maximum_validity_seconds": { "const": 2592000 },
        "observed_at_utc": { "$ref": "#/$defs/utcSecond" },
        "source_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "valid_until_utc": { "$ref": "#/$defs/utcSecond" },
        "verified_at_utc": { "$ref": "#/$defs/utcSecond" }
      },
      "required": [
        "input_id",
        "source_fingerprint",
        "evaluated_at_utc",
        "observed_at_utc",
        "verified_at_utc",
        "valid_until_utc",
        "maximum_validity_seconds",
        "classification"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "identifier": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "type": "string"
    },
    "nullableFingerprint": {
      "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }]
    },
    "nonStoreError": {
      "enum": [
        "evidence_record_missing",
        "dependency_missing",
        "unsafe_path",
        "identity_changed",
        "read_failed",
        "oversized",
        "non_canonical",
        "schema_invalid",
        "fingerprint_mismatch",
        "wrong_authority",
        "chain_invalid",
        "transaction_tip_mismatch",
        "producer_invalid",
        "dependency_unresolved",
        "not_current",
        "contradiction"
      ]
    },
    "nonStoreRetainedError": {
      "enum": [
        "dependency_missing",
        "unsafe_path",
        "identity_changed",
        "read_failed",
        "oversized",
        "non_canonical",
        "schema_invalid",
        "fingerprint_mismatch",
        "wrong_authority",
        "chain_invalid",
        "transaction_tip_mismatch",
        "producer_invalid",
        "dependency_unresolved",
        "not_current",
        "contradiction"
      ]
    },
    "resolvedInput": {
      "additionalProperties": false,
      "properties": {
        "input_class": { "const": "admitted_evidence_ref" },
        "input_id": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/sourceRecord" },
        "source_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "source_ref": {
          "pattern": "^sources/admitted-evidence_[0-9a-f]{64}[.]json$",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "input_class",
        "source_ref",
        "source_fingerprint",
        "source"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "semanticRef": {
      "allOf": [
        { "not": { "pattern": "^\\.{1,2}$" } },
        { "not": { "pattern": "^[A-Za-z]:" } }
      ],
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^/\\\\\\u0000-\\u001F\\u007F\\s]+$",
      "type": "string",
      "x-handbook-max-utf8-bytes": 256,
      "x-handbook-normalization": "NFC"
    },
    "sourceRecord": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_kind": { "const": "qualifying_responsibility_present" }
            },
            "required": ["claim_kind"]
          },
          "then": {
            "properties": {
              "surface_kind": {
                "enum": [
                  "runtime",
                  "deployment",
                  "operated_automation",
                  "operational_integration"
                ]
              },
              "surface_ref": { "$ref": "#/$defs/semanticRef" }
            }
          },
          "else": {
            "properties": {
              "surface_kind": { "type": "null" },
              "surface_ref": { "type": "null" }
            }
          }
        }
      ],
      "properties": {
        "$schema": {
          "const": "handbook.schemas.project-condition-admitted-evidence-source@1.0.0"
        },
        "claim_kind": {
          "enum": [
            "qualifying_responsibility_present",
            "no_qualifying_responsibility",
            "unknown"
          ]
        },
        "condition_ref": {
          "const": "handbook.condition.project.managed-operational-surface@1.0.0"
        },
        "observed_at_utc": { "$ref": "#/$defs/utcSecond" },
        "repository_identity_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "schema_id": {
          "const": "handbook.project-condition-admitted-evidence-source"
        },
        "schema_version": { "const": "1.0" },
        "source_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "source_kind": { "const": "operator_responsibility_attestation" },
        "surface_kind": {
          "oneOf": [
            {
              "enum": [
                "runtime",
                "deployment",
                "operated_automation",
                "operational_integration"
              ]
            },
            { "type": "null" }
          ]
        },
        "surface_ref": {
          "oneOf": [{ "$ref": "#/$defs/semanticRef" }, { "type": "null" }]
        },
        "valid_until_utc": { "$ref": "#/$defs/utcSecond" }
      },
      "required": [
        "$schema",
        "schema_id",
        "schema_version",
        "source_id",
        "source_kind",
        "condition_ref",
        "repository_identity_fingerprint",
        "observed_at_utc",
        "valid_until_utc",
        "claim_kind",
        "surface_kind",
        "surface_ref",
        "source_fingerprint"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "utcSecond": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "outcome": { "const": "refused" },
            "reason": { "const": "evidence_refused" }
          }
        },
        {
          "properties": {
            "outcome": { "const": "unresolved" },
            "reason": { "const": "evidence_record_missing" }
          }
        },
        {
          "properties": {
            "outcome": { "const": "unresolved" },
            "reason": { "const": "evidence_dependency_unresolved" }
          }
        },
        {
          "properties": {
            "outcome": { "const": "stale" },
            "reason": { "const": "evidence_not_current" }
          }
        },
        {
          "properties": {
            "outcome": { "const": "unknown" },
            "reason": { "const": "insufficient_current_proof" }
          }
        },
        {
          "properties": {
            "outcome": { "const": "false" },
            "reason": { "const": "affirmative_no_qualifying_responsibility" }
          }
        },
        {
          "properties": {
            "outcome": { "const": "true" },
            "reason": { "const": "qualifying_continuing_responsibility" }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "evidence_head_fingerprint": { "type": "null" },
            "evidence_record_fingerprint": { "type": "null" },
            "producer_verification_fingerprint": { "type": "null" }
          }
        },
        {
          "properties": {
            "evidence_head_fingerprint": { "$ref": "#/$defs/fingerprint" },
            "evidence_record_fingerprint": { "type": "null" },
            "producer_verification_fingerprint": { "type": "null" }
          }
        },
        {
          "properties": {
            "evidence_head_fingerprint": { "$ref": "#/$defs/fingerprint" },
            "evidence_record_fingerprint": { "$ref": "#/$defs/fingerprint" },
            "producer_verification_fingerprint": { "type": "null" }
          }
        },
        {
          "properties": {
            "evidence_head_fingerprint": { "$ref": "#/$defs/fingerprint" },
            "evidence_record_fingerprint": { "$ref": "#/$defs/fingerprint" },
            "producer_verification_fingerprint": {
              "$ref": "#/$defs/fingerprint"
            }
          }
        }
      ]
    }
  ],
  "properties": {
    "closure_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "condition_definition_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "condition_ref": {
      "const": "handbook.condition.project.managed-operational-surface@1.0.0"
    },
    "dependency_observations": {
      "items": { "$ref": "#/$defs/dependencyObservation" },
      "minItems": 1,
      "type": "array"
    },
    "evaluated_at_utc": { "$ref": "#/$defs/utcSecond" },
    "evaluator_definition_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "evaluator_ref": {
      "const": "handbook.condition-evaluator.managed-operational-surface@1.0.0"
    },
    "evidence_head_fingerprint": { "$ref": "#/$defs/nullableFingerprint" },
    "evidence_record_fingerprint": { "$ref": "#/$defs/nullableFingerprint" },
    "freshness_basis": {
      "items": { "$ref": "#/$defs/freshnessRow" },
      "maxItems": 16,
      "type": "array"
    },
    "ordered_inputs": {
      "items": { "$ref": "#/$defs/resolvedInput" },
      "maxItems": 16,
      "type": "array"
    },
    "outcome": {
      "enum": ["refused", "unresolved", "stale", "unknown", "false", "true"]
    },
    "producer_verification_fingerprint": {
      "$ref": "#/$defs/nullableFingerprint"
    },
    "reason": {
      "enum": [
        "evidence_refused",
        "evidence_record_missing",
        "evidence_dependency_unresolved",
        "evidence_not_current",
        "insufficient_current_proof",
        "affirmative_no_qualifying_responsibility",
        "qualifying_continuing_responsibility"
      ]
    },
    "repository_identity_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "schema_id": {
      "const": "handbook.project-condition-evidence-evaluation-closure"
    },
    "schema_version": { "const": "1.0" }
  },
  "required": [
    "schema_id",
    "schema_version",
    "evaluator_ref",
    "evaluator_definition_fingerprint",
    "condition_ref",
    "condition_definition_fingerprint",
    "repository_identity_fingerprint",
    "evaluated_at_utc",
    "dependency_observations",
    "evidence_head_fingerprint",
    "evidence_record_fingerprint",
    "producer_verification_fingerprint",
    "freshness_basis",
    "ordered_inputs",
    "outcome",
    "reason",
    "closure_fingerprint"
  ],
  "type": "object",
  "unevaluatedProperties": false,
  "x-handbook-dependency-order": [
    "evidence_transaction_store",
    "evidence_head",
    "evidence_transaction",
    "evidence_record",
    "admitted_source",
    "condition_definition",
    "evaluator_definition",
    "repository_identity",
    "registry_head_transition",
    "registry_state",
    "credential_registration",
    "authenticator_use_head",
    "challenge",
    "decoded_assertion_response",
    "assertion",
    "evidence_use_transition"
  ],
  "x-handbook-fingerprint": {
    "algorithm": "sha256",
    "canonicalization": "RFC8785",
    "exclude": ["closure_fingerprint"],
    "field": "closure_fingerprint"
  },
  "x-handbook-semantic-rules": [
    "dependency observations are ordered by dependency enum, then ascending sequence, input_id, or logical_id",
    "the transaction-store row is always first and every attempted dependency produces exactly one row",
    "retained-directory byte_count and observed_bytes_fingerprint cover the complete RFC8785 {filename_encoding,entries} envelope without LF",
    "required, claimed, and computed fingerprints are null for the transaction-store row",
    "retained bytes always bind exact raw byte_count and SHA-256; claimed/computed values remain null only until their fields or preimages are reached",
    "an accepted observation has null error_code and every rejected observation has one exact error_code",
    "freshness and ordered inputs include only rows resolved before the winning branch and are empty before any input resolves",
    "freshness_basis and ordered_inputs have identical input_id order and each resolved source/fingerprint/ref replays exactly",
    "classification is verification_not_yet_valid before verified_at_utc, observation_not_yet_valid before observed_at_utc, current at both inclusive lower bounds through inclusive valid_until_utc, and expired afterward",
    "mixed current and non-current inputs resolve stale",
    "first-match outcome precedence is refused, unresolved missing head, unresolved dependency, stale, unknown, false, true",
    "a current qualifying-positive combined with a current global negative is refused",
    "all current unknowns produce unknown; a global negative with no positive produces false; a positive with no global negative produces true",
    "bare silence never produces false",
    "true maps only to Required, false only to Optional, and all other outcomes only to Indeterminate",
    "evidence_head_fingerprint, evidence_record_fingerprint, and producer_verification_fingerprint become non-null only after the corresponding record is established",
    "strings and timestamps are not repaired, and file mtimes, presentation timestamps, Environment Context bytes, Markdown, applicability_basis, artifact presence, profile flags, and ambient environment have zero influence"
  ],
  "x-handbook-transaction-store": {
    "empty_envelope_bytes": { "utf8": 41, "windows_utf16le": 52 },
    "filename_encodings": ["utf8", "windows_utf16le"],
    "limit_observation": {
      "byte_count": null,
      "claimed_fingerprint": null,
      "computed_fingerprint": null,
      "error_code": "transaction_store_over_limit",
      "observation_kind": "directory_limit_exceeded",
      "observed_bytes_fingerprint": null,
      "required_fingerprint": null
    },
    "maximum_canonical_envelope_bytes": 131072,
    "maximum_entries": 4096,
    "semantic_rules": [
      "missing, unsafe, unreadable, over-limit, then retained-directory validation is strict first-match order",
      "candidate count uses checked_add and refuses greater than 4096 before copying, retaining, measuring, validating, sorting, encoding, serializing, fingerprinting, or requesting another entry",
      "base64 length is checked 4 * floor((n + 2) / 3) and projected envelope size uses checked arithmetic",
      "projected envelope bytes include the empty envelope, one comma after the first entry, two JSON quote bytes, and base64 text bytes",
      "greater than 131072 or any arithmetic failure emits the fixed over-limit row before retaining the offender",
      "only a fully enumerated bounded directory is raw-byte sorted, base64 encoded, serialized once, length-checked against the projection, and fingerprinted",
      "alias detection precedes invalid-name detection only after the complete bounded envelope exists",
      "count, byte, and checked-arithmetic limit failures share one platform-independent fixed closure and bind no name, encoding, count, size, ceiling, envelope, or fingerprint",
      "all bounded directories retain and fingerprint their complete envelope; over-limit enumeration retains no offender, serializes no complete or partial envelope, computes no listing fingerprint, discards prior names, and requests no later entry"
    ]
  }
}
