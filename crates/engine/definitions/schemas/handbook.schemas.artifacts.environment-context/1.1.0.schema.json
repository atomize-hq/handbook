{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "handbook.artifact.environment-context"
    },
    "schema_version": {
      "const": "1.1"
    },
    "record_id": {
      "$ref": "#/$defs/recordId"
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "environment_id": {
            "$ref": "#/$defs/symbolicId"
          },
          "description": {
            "$ref": "#/$defs/longText"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/capabilityId"
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "environment_id",
          "description",
          "capabilities"
        ],
        "additionalProperties": false,
        "unevaluatedProperties": false
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "authoritative_references": {
      "$ref": "#/$defs/referenceList"
    },
    "known_unknowns": {
      "$ref": "#/$defs/optionalLongTextList"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "environments",
    "authoritative_references",
    "known_unknowns"
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000]+$"
    },
    "stableRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 320,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+(?:@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)?$"
    },
    "symbolicId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "referenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableRef"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "optionalLongTextList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/longText"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "recordId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"
    }
  }
}
