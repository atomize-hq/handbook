+fn text(v: &str) -> Result<(), LocalAuthorityRefusalV1> {
+    if v.trim().is_empty() || v.len() > 4096 || v.contains('\0') {
+        Err(refuse("work_text", "explicit bounded text required"))
+    } else {
+        Ok(())
+    }
