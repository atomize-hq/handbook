+impl fmt::Display for RegistryLoadError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        if let Some(location) = &self.location {
+            write!(formatter, "{location}: {}", self.detail)
+        } else {
+            formatter.write_str(&self.detail)
+        }
+    }
+}
