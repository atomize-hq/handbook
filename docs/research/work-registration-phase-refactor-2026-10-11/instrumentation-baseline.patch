+        .map_err(fs_error)?
+    {
+        RepositoryReadV1::Found(bytes) => Ok(bytes),
+        RepositoryReadV1::Absent => Err(refuse(
+            "required_state_missing",
+            "required retained authority state is absent; no bootstrap or reset is permitted",
