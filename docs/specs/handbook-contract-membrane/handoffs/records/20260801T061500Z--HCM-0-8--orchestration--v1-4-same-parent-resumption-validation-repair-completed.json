  "decisions": [
    {
      "decision_id": "HCM-0.8-V14-RESUMPTION-D1",
      "summary": "A completed v1.4 handoff is always terminal; no successor or later same-parent dispatch is admitted.",
      "authority_effect": "Resumption after completion remains a validation failure.",
      "refs": ["docs/specs/handbook-contract-membrane/08-handoff-ledger-and-escalation-protocol.md", "docs/specs/handbook-contract-membrane/handoffs/validate_handoffs.py"]
    },
    {
      "decision_id": "HCM-0.8-V14-RESUMPTION-D2",
      "summary": "A non-completed handoff remains a fail-closed cutoff unless its direct same-orchestration successor names it in both source_handoff_ids and supersedes while preserving all frozen identities.",
      "authority_effect": "Broken chains, cross-parent successors, identity drift, and orphan later dispatches fail closed without rewriting interim history.",
      "refs": ["docs/specs/handbook-contract-membrane/slices/HCM-0.8/decision/20260801-v1-4-same-parent-resumption-validation-repair.md"]
    },
    {
      "decision_id": "HCM-0.8-V14-RESUMPTION-D3",
      "summary": "Dispatch and ancillary authority are evaluated at each record's exact cutoff; completed ancillary authority additionally freezes at the canonical final CLEAN review ordering key.",
      "authority_effect": "Later authority cannot retroactively invalidate interim records or widen a completed reviewed subject.",
