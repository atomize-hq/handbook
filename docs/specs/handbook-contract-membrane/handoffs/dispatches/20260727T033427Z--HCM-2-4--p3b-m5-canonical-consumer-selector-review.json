  "repo_truth": "The reviewed identity and feature-ID repairs make six focused Stage 10 behaviors pass. M5 emits and validates the correct fs-m4-foundation-journey-2026-04 bundle, then its private consumer fails because it requests artifacts/feature_spec/FEATURE_SPEC.md, which P3 correctly excludes as a generated view. The authoritative bundle input is artifacts/work-specification/work-specification.yaml. The current two foundation-flow Work Specification inputs contain only generic objective/scope/acceptance content apart from the reviewed record_id. No production failure is observed.",
  "allowed_scope": [
    "Read-only replay of all 25 manifest entries and the exact selector-amendment diff.",
    "Trace the private M5 repo-baseline and bundle-only consumer paths, canonical YAML parser, renderer, and scorecard inputs.",
    "Validate the proposed exact M4 Work Specification record against the selected schema and current P3 contract.",
    "Determine whether the three private helper edits, two input fixtures, two generated views, expected plan, scorecard, and already selected transcripts are necessary, sufficient, minimal, and independently reviewable.",
    "Validate that no Cargo, support-module, production, runtime, handoff, renderer, schema, shared-corpus, or sibling change is required.",
    "Apply the 04 reviewability indicators and identify findings independently before comparing P3/P4 candidates with 09."
  ],
  "non_goals": [
    "No edits, formatting, staging, commit, push, handoff, ledger, dispatch, or delegation.",
    "No production/runtime, handoff input/logic, renderer, schema, released definition, shared pipeline corpus, foundation-flow stage 04-07 input, public API, dependency, Cargo/version, unsafe-policy, P2, P4, P5, P6, or sibling-slice change.",
    "Do not review or approve future helper, fixture, expected, scorecard, transcript, or broader P3B implementation bytes."
  ],
  "tasks": [
    "Verify complete subject identity and inspect the exact selector-amendment delta.",
    "Reproduce or trace the M5 missing-view-input failure and confirm canonical YAML is the only authoritative replacement.",
    "Validate the proposed M4 Work Specification fields, record identity, schema admission, generated-view implications, and planning-consumer mapping.",
    "Determine whether all selected helper/evidence paths are necessary and whether any unlisted material path is required.",
    "Return findings first in Critical, Required, Optional, Nit order with exact file/line, violated contract, why wrong, smallest remediation, and missing verification."
  ],
  "contracts_and_gates": [
    "P3 canonical Work Specification YAML is authoritative and the Markdown view is generated/non-authoritative",
    "M5 repo-baseline and bundle-only consumers must plan from the same canonical bytes",
    "M4 feature identity remains fs-m4-foundation-journey-2026-04",
    "Only the exact private helpers and test/evidence paths may change",
    "No production symbol, Cargo change, or broader schema inference is authorized"
  ],
  "stop_conditions": [
    "Return blocked if subject identity or required read-only evidence cannot be established.",
    "Report rather than repair any finding.",
    "Do not edit, delegate, create another dispatch, write a handoff, modify the ledger, stage, commit, or push."
  ],
