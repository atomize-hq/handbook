  "repo_truth": "P1A discovery subject sha256:4edbc4fe580a3c819fcdac64bd83623d09ebc2337f0d3c170d8f7d0ecd927865 returned p1a-discovery-P2-1 and P2-2. The cross-document correction is CLEAN at sha256:e9988a33e3278ea908a5114bca8c8ffb75e8301358ca7410b246cda473cfba5c. This complete 39-path remediation baseline is sha256:0717385e0fd7adeb8f380479e7a06b0a3a6535e00cde4005f5a75040d76b1d35. Fresh exact impacts are LOW/11 for ArtifactIntakeDefinitionV1::parse, LOW/0 for AuthoredArtifactKindDefinition::validate, CRITICAL/130 for validate_authored_profile_fingerprints, and CRITICAL/44 for load_repository_intakes. The CRITICAL radius is accepted only for exact P1A/1.2 branches.",
  "allowed_scope": [
    "Replay the exact 39-entry baseline and the clean selector-correction dispatch before edits.",
    "Write only the five intake, five renderer, five kind successor definitions, shipped-root 1.2 definition, artifact_kind_registry.rs, artifact_intake_registry.rs, artifact_repository.rs, profile_selection.rs, hcm_2_4_definition_support.rs, new hcm_2_4_definition_runtime.rs, definition-support vectors, renderer goldens, and P1A proof.",
    "In ArtifactIntakeDefinitionV1::parse, compute the exact five P1A intake fingerprints from authored definition plus typed kind/schema dependencies while preserving every other intake path.",
    "In AuthoredArtifactKindDefinition::validate, compute the exact five successor kind fingerprints from typed stable-role, schema entry/closure, and renderer dependencies while preserving every other kind path.",
    "In validate_authored_profile_fingerprints, add only the shipped-root 1.2 uniform dependency closure using the established HCM-2.2 envelope.",
    "In load_repository_intakes, retain only handbook.intake.charter@1.0.0 on built-in compatibility and route exactly the five P1A intakes through full semantic parse/admission.",
    "Use RED-GREEN-REFACTOR to prove each stale subordinate fingerprint and real repository-path failure before correction.",
    "Run the exact 13-target P1A wall plus hcm_2_4_definition_runtime and unchanged hcm_2_3_registration_kernel; preserve the HCM-2.3 file hash exactly."
  ],
  "non_goals": [
    "Do not edit artifact_instance.rs, profile_builtins.rs, load_with_builtin_compatibility, resolve_profile_selection, hcm_2_3_registration_kernel.rs, selector correction docs, P0 proof, prior dispatches, or released definitions.",
    "No P1B-P7, public API/signature, generic repository-definition behavior, dependency, Cargo/package/version, unsafe, command, module/process contract, Resolution, Projection, migration, dual-read, shipped-default switch, sibling-slice change, staging, commit, push, handoff, ledger, dispatch, or independent-review claim."
  ],
  "tasks": [
    "Replay the baseline, clean selector correction, frozen HCM-2.3 hash, and all four fresh exact impacts.",
    "Add focused failing proof for both discovery findings before remediation.",
    "Implement the smallest exact typed-closure and Charter-only compatibility branches.",
    "Recompute all affected immutable fingerprints/vectors and the literal profile 1.2 fingerprint from the complete dependency graph.",
    "Prove actual ArtifactRepositoryV1::open admission for every new package intake plus wrong/stale/missing/mode/coverage refusal and no Charter compatibility expansion.",
    "Run focused, packet, formatting, diff, scoped-path, and GitNexus change-detection checks; return exact results to the parent."
  ],
