  "repo_truth": "Exact product tests and full engine/workspace walls pass. Scoped GitNexus detection reports 13 product files, 159 symbols, 36 processes, CRITICAL within the selected ceiling; compare-to-main reports the whole feature lineage. FTS is unavailable, not GREEN. The direct-seed fixture is deleted. Protected WIP and protected paths remain read-only.",
  "allowed_scope": [
    "Review the complete exact subject read-only through the security and authority-substitution lens.",
    "Attack the complete current-authority chain: capsule canonicality/domains, publisher signature/client/RP/flags/counter/challenge, credential/use-head, live registry transition, generic committed lineage, predecessor quartet, revocation/staleness, cloned envelope/candidate/request reconsumption, and historical/pending non-capability.",
    "Attempt hash-consistent substitution, marker-only/currentness bypass, cache/clone lifetime extension, different-candidate quarantine completion, restored-old authority use, or proof overclaim across every operational consumer.",
    "Return stable source finding IDs 001-006 as closure targets and unique fresh IDs only for actual new subject defects; do not rename historical findings or repair anything."
  ],
  "non_goals": [
    "Do not edit, format, test, stage, commit, delegate, write handoff/ledger, or mutate protected paths.",
    "Do not reopen planning, trust/publish the quarantined checkpoint, broaden generic recovery, add public/dependency/tooling/H2/H3/HCM-3.3 scope, waive P1/P2, or treat compare-to-main feature lineage as this slice alone."
  ],
  "tasks": [
    "Replay the exact 24-entry subject manifest and explicit deletion before review.",
    "Review only the consolidated remediation delta plus affected contracts and call paths for HCM32-JCS-IMPL-DISC-004, 005, and 006.",
    "Prove generic non-HCM missing-native-result recovery remains fail-closed with no state mutation.",
    "Prove exact quarantine candidate and deterministic idempotency admission happens before publication mutation, refused results preserve the prior authority, and completion binds the exact committed T2 chain.",
    "Prove exact replay and post-T2/partial-closeout crash recovery are idempotent and fail closed on mismatch.",
    "Regression-check stable repairs 001/002/003, proof truthfulness, production/test ceilings, and prohibited-scope exclusions.",
    "Return CLEAN only when no P1/P2 remains; otherwise return only directly caused or unmasked closure findings."
  ],
  "contracts_and_gates": [
    "No unresolved P1/P2, historical/pending operational capability, generic non-HCM widening, substitute quarantine closure, stale clone/request consumption, proof overclaim, or scope/ceiling breach may proceed.",
    "The parent consolidates all three same-cycle burst results before one remediation. No burst member repairs or dispatches.",
    "A sixth production path, unexpected HIGH/CRITICAL edit, public/dependency/tooling/owner/transport expansion, shipped identity change, or H2/H3/HCM-3.3 work is a stop."
  ],
  "stop_conditions": [
    "Return FINDINGS rather than repair for every valid P1/P2.",
    "Return BLOCKED if closure requires new authority, public API/dependency/tooling change, broader path/risk, generic ownership expansion, or deferred work."
  ],
