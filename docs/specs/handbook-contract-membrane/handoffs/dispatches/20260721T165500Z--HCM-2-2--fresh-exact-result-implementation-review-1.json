  "repo_truth": "The exact 41-path raw-byte subject is the complete bounded HCM-2.2 candidate-1.3 exact-result implementation from reviewed baseline f676ea59bbbbcdd0ecc3475bbf2dabd80f5c9d4d. It repairs HCM-2.2-AR3-001 without changing lifecycle-validation-result 1.0 or promotion-intent 1.2 schemas, preserves all historical candidates and orphan evidence, and retains the reviewed atomic publication/recovery/lifecycle/product obligations. Native workspace, Linux installed-runtime, package, schema, archive, handoff, link, scope, secret, formatting, Clippy, docs, and frozen-byte proofs pass. Independently establish correctness; this summary and every earlier verdict are non-authoritative.",
  "allowed_scope": [
    "Remain read-only and replay all 41 manifest hashes plus the aggregate before review.",
    "Read AGENTS.md, the selected handoff, decision, complete SPEC, implementation/review plan, remaining/current checklist, proof wall, rejected Review 3 dispatch, and every manifest path.",
    "Review the complete HCM-2.2 implementation for correctness, identity acyclicity, exact-byte authority, stable replay, evidence preservation, approval/promotion currentness, atomicity, recovery, lifecycle, product cutover, tests, documentation truth, and bounded scope.",
    "Attempt to falsify every required coherent rewrite, timestamp rewrite, wrong digest/length, semantic/raw crossing, forged/multiple candidate, zero/one/many discovery, missing/orphan, unsafe store, historical-version, stale-authority, W0-W15, R0-R9, and S0-S11 case.",
    "Return Critical, Required, Optional, and Nit findings first with exact file/line evidence, reproduction where possible, and smallest bounded remediation."
  ],
  "non_goals": [
    "No edits, staging, commits, handoff/ledger writes, branch changes, or user task hops.",
    "No HCM-2.3, generic custom-kind intake, remaining artifact conversion, Resolution/Projection/Snapshot/posture-kernel, SDK/Tauri/Substrate/dock/publication work, or unrelated cleanup.",
    "Do not rely on the proof summary, prior reviewer verdicts, rejected checkpoint behavior, or success-asserting documentation as authority."
  ],
  "tasks": [
    "Invoke the ordered required skills and return BLOCKED on any subject path, hash, order, count, or aggregate mismatch.",
    "Admit the exact 41-path subject and read the full diff plus relevant surrounding code before commenting.",
    "Independently audit the candidate-subject/result/final-candidate/approval/promotion/intent graph for cycles, implicit bindings, self-authentication, copied authority, or currentness gaps.",
    "Audit the two-store author-lock inventory for native no-follow identity, stable double-scan completeness, bounds, zero/one/many classification, crossing, orphan/missing behavior, mutation races, and fail-before-delta preservation.",
    "Audit approval and promotion independently against semantic and exact persisted result authority plus canonical, policy, lifecycle, observation, coverage, registry, and retained-head currentness.",
    "Audit atomic scratch publication and every W0-W15, R0-R9, S0-S11 recovery/refusal boundary for unauthenticated mutation, evidence loss, partial authority, and unsupported completion.",
    "Audit historical candidate 1.0/1.1/1.2 refusal, candidate 1.3 fresh approval, compiler/CLI/runtime vectors/live smoke assertions, frozen schemas, test-only hooks, platform behavior, control-pack gate claims, and HCM-2.3 exclusion.",
    "Return CLEAN only when no Critical, Required, Optional, or Nit finding remains; otherwise return CHANGES_REQUIRED or BLOCKED without repairing the subject."
  ],
  "contracts_and_gates": [
    "docs/specs/handbook-contract-membrane/07-orchestration-onboarding-prompt.md#phase-5--fresh-review--remediation-loop",
    "docs/specs/handbook-contract-membrane/slices/HCM-2.2/SPEC.md#verification-and-promotion-gates",
    "docs/specs/handbook-contract-membrane/06-proof-and-regression-ledger.md#hcm-22-constitutional-root-implementation-proof-gate"
  ],
  "stop_conditions": [
    "Return BLOCKED if any subject path, raw SHA-256, count, order, or aggregate differs.",
    "Return CHANGES_REQUIRED for any Critical, Required, Optional, or Nit correctness, security, identity, durability, replay, orphan, currentness, recovery, product, proof, documentation, or scope finding.",
    "Stop on any implicit, self-referential, or cyclic identity; unauthenticated exact result; ambiguous stable replay/orphan state; expanded elevated path; frozen result/intent schema change; or HCM-2.3 work.",
    "Do not repair the subject or create closeout records."
  ],
