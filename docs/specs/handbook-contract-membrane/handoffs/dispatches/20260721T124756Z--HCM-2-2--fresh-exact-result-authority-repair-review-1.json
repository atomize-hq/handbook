  "repo_truth": "The rejected Review 3 implementation remains untouched at exact HEAD 486458acfe8373a977e595a4854ac786166e3e76 and is preserved in an externally verified archive. This separate clean worktree contains only a documentation/control-pack repair. Candidate 1.3, not candidate 1.2, independently selects exact persisted lifecycle-validation result JCS+LF bytes while preserving the result 1.0 and intent 1.2 schemas byte-for-byte. No Rust or HCM-2.3 work is authorized.",
  "allowed_scope": [
    "Remain read-only and replay all 27 manifest hashes, sorted order, and aggregate before review.",
    "Independently review the complete candidate 1.3 subject/final identity, exact result binding, result 1.0 semantic identity and persisted bytes, approval/promotion/intent transitivity, and topological acyclicity.",
    "Adversarially review freeze-author locking, independent recomputation, bounded no-follow discovery, zero/one/many cardinality, exact replay equality, orphan classification, missing/unsafe/crossed/mismatching refusal, evidence preservation, and no automatic crash completion.",
    "Review migration for immutable candidate 1.0/1.1/1.2 evidence, mandatory 1.3 reauthoring/new approval, no dual read/upgrade/ref copy/fallback/carry-forward, and unchanged result/intent schemas.",
    "Verify all required negative vectors, retained atomic promotion recovery obligations, cross-document status truth, and documentation-only scope."
  ],
  "non_goals": [
    "No edits, staging, commits, handoff/ledger writes, archive/source-worktree mutation, or user task hop.",
    "No Rust/test implementation, implementation resumption, result 1.0 or intent 1.2 schema change, fallback/dual read, immutable evidence rewrite, HCM-2.3 work, or adjacent cleanup.",
    "Do not inherit Review 1-3 or parent conclusions; derive the entire result independently."
  ],
  "tasks": [
    "Invoke the ordered review disciplines and return BLOCKED on any manifest mismatch.",
    "Replay every JCS fingerprint plus exact JCS+LF SHA-256/length, schema identity, cross-vector binding, and candidate-subject/result/final separation independently.",
    "Prove the graph is acyclic and that result binds subject only, final candidate binds the full exact-result tuple, approval binds final candidate, and promotion/intent 1.2 bind it transitively.",
    "Exercise the required coherent rewrite, timestamp rewrite, forged second candidate, zero/one/many, orphan, missing, wrong digest/length, semantic/raw crossing, unsafe entries, candidate 1.2 fallback, approval carry-forward, and refusal mutation/deletion negatives.",
    "Return CLEAN only with no Critical, Required, Optional, or Nit finding; otherwise CHANGES_REQUIRED or BLOCKED with exact evidence, failure mode, smallest repair, and missing validation."
  ],
