  "repo_truth": "The complete cli_surface wall passes 95/98. The remaining three failures compare only the two named shared compile goldens after the fixture core was synchronized to reviewed P3 Work Specification authority. Two CLI tests reuse the payload golden and one uses the explain golden. Existing compiler pipeline_compile tests consume the same two files. No production or assertion failure is observed.",
  "allowed_scope": [
    "Read-only replay of all 16 manifest entries and the exact selector-amendment diff.",
    "Trace all CLI and compiler consumers of the paired shared goldens.",
    "Validate that actual output is determined by the synchronized reviewed fixture core and fixed clock/path normalization.",
    "Determine whether the exact two files are necessary, sufficient, minimal, and mechanical, with no unlisted source/assertion/fixture edit.",
    "Apply the 04 reviewability indicators and identify findings independently before comparing P3/P4 candidates with 09."
  ],
  "non_goals": [
    "No edits, formatting, staging, commit, push, handoff, ledger, dispatch, or delegation.",
    "No production/runtime, CLI/compiler source or assertion, schema, released definition, profile, shared fixture input, public API, dependency, Cargo/version, unsafe-policy, P2, P4, P5, P6, or sibling-slice change.",
    "Do not approve future regenerated golden bytes or the broader P3B implementation delta."
  ],
  "tasks": [
    "Verify complete subject identity and inspect the exact selector-amendment delta.",
    "Reproduce or trace the 95/98 wall and identify every consumer of both shared goldens.",
    "Validate that only deterministic golden regeneration is required and that the unrelated-malformed-stage negative remains meaningful.",
    "Return findings first in Critical, Required, Optional, Nit order with exact file/line, violated contract, why wrong, smallest remediation, and missing verification."
  ],
  "contracts_and_gates": [
    "P3 Work Specification compile output and synchronized fixture authority remain unchanged",
    "Payload/explain CLI and compiler consumers share exact deterministic golden bytes",
    "Malformed unrelated stage remains ignored without altering compiled payload",
    "Only the exact two golden files may change",
    "No production symbol or broader schema inference is authorized"
  ],
  "stop_conditions": [
    "Return blocked if subject identity or required read-only evidence cannot be established.",
    "Report rather than repair any finding.",
    "Do not edit, delegate, create another dispatch, write a handoff, modify the ledger, stage, commit, or push."
  ],
