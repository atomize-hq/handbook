  "repo_truth": "The complete current 35-path dirty subject is sha256:4edbc4fe580a3c819fcdac64bd83623d09ebc2337f0d3c170d8f7d0ecd927865 against baseline HEAD 0b177ef9415e942cde763fcb086cec546a9a24f3. P1A changes three runtime files, adds 16 immutable definitions, one integration target, two immutable vector/golden assets, and one proof record; remaining paths are P0 authority and prior internal dispatch evidence. Parent replay recorded 66 passing tests across the exact 13 targets, cargo fmt and git diff checks passing, and GitNexus change detection LOW with zero affected processes. Generic execution of the new package built-in intakes is known unavailable because the existing compatibility loader strips modes and coverage; no broader execution or seam promotion is claimed.",
  "allowed_scope": [
    "Replay the exact 35-entry subject manifest, baseline diff, and aggregate fingerprint.",
    "Review the P1A definitions, three runtime guard/mapping edits, integration test, vectors/goldens, and proof against exact P1A authority.",
    "Verify all five kind/intake/renderer rows and the three-instance 1.2 profile are exact, immutable, fingerprint-correct, duplicate-safe, schema-bound, deterministic, Resolution-free, and fail closed on every forbidden near miss.",
    "Verify the released 1.1 Project Authority descriptor is preserved field-for-field in 1.2 and the shipped request remains 1.1.",
    "Trace the two changed guard call paths, the CRITICAL resolver boundary, built-in resolution, and all positive/negative proof without assuming test assertions are correct.",
    "Assess whether the known unavailable generic built-in intake execution is honestly outside P1A or violates an exact P1A acceptance gate.",
    "Identify findings independently before comparing P3/P4 candidates with the selected-scope inventory."
  ],
  "non_goals": [
    "No edits, formatting, staging, commits, pushes, handoffs, ledger writes, dispatch creation, or delegation.",
    "Do not review P1B-P7 implementation or propose cleanup unrelated to the integrated P1A outcome.",
    "No HCM-3.x, Resolution, Projection, generic renderer engine, dynamic command, migration, dual-read, public API, dependency, Cargo, package, version, unsafe, module/process, or sibling-slice expansion.",
    "Do not promote any seam or proof classification; P1A may establish only static package publication, exact frozen admission, and its named proof."
  ],
  "tasks": [
    "Verify exact subject identity, no hidden changed path, and P1A selector compliance.",
    "Review correctness and security of all three runtime edits, including exact-ref admission, missing/extra/mismatch/later-owned refusal, duplicate and cardinality handling, and dynamic built-in mapping completeness.",
    "Independently verify definition and profile fingerprints, Project Authority row preservation, renderer goldens, schema/intake coverage, and default-profile non-switch.",
    "Review test adequacy for positive, negative, fail-closed, regression, and CRITICAL-radius behavior, including whether the large new integration test can mask a wrong implementation.",
    "Validate the proof record and known unavailable proof against live code.",
